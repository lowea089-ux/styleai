{
  "name": "styleai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StyleAI – digitaler Kleiderschrank und KI-Outfit-Generator",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --watch-preserve-output --import tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p . && vite build",
    "start": "cross-env NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "vite preview --mode web",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "desktop:bundle": "node scripts/build-desktop.mjs",
    "desktop:start": "npm run build && npm run desktop:bundle && electron .",
    "desktop:build": "npm run build && npm run desktop:bundle && electron-builder --win portable --x64",
    "desktop:installer": "npm run build && npm run desktop:bundle && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@decartai/sdk": "^0.2.14",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sql.js": "^1.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "dist-desktop/main.cjs",
  "author": "StyleAI",
  "build": {
    "appId": "app.styleai.desktop",
    "productName": "StyleAI",
    "copyright": "StyleAI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/{@anthropic-ai,@google,@hono,hono,zod,tsx,esbuild,@esbuild,cross-env,google-auth-library,gaxios,gcp-metadata,ws}/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "StyleAI-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "StyleAI-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
