# ---------------------------------------------------------------------------
# StyleAI – Umgebungsvariablen. Kopieren nach .env und anpassen.
# Ohne jede Variable läuft die App im lokalen Modus (ohne externe KI).
# ---------------------------------------------------------------------------

# Port des API-Servers in der Entwicklung (Vite leitet /api dorthin weiter)
API_PORT=8787
# In Produktion liefert ein einziger Server App + API aus; Hosting-Plattformen setzen dafür meist PORT.
# PORT=8080

# Verzeichnis für Datenbank und private Bilder
DATA_DIR=./data

# Geheimer Schlüssel (mind. 32 Zeichen). Verschlüsselt u. a. gespeicherte API-Schlüssel.
# Leer: wird einmalig zufällig erzeugt und in DATA_DIR/.secret abgelegt (diese Datei mitsichern!).
SESSION_SECRET=

# Öffentliche URL der App in Produktion (für den CSRF-/Origin-Check), z. B. https://styleai.example.com
APP_ORIGIN=

# Einladungscode: Wenn gesetzt, kann sich nur registrieren, wer ihn kennt.
# Für jede im Internet erreichbare Installation dringend empfohlen.
REGISTRATION_CODE=

# --- KI (optional) ---------------------------------------------------------
# Jede Person kann in der App unter „Mein Stil → KI-Anbieter“ einen eigenen Schlüssel hinterlegen.
# Die Variablen hier legen einen Standard-Anbieter des Betreibers fest (für alle ohne eigenen Schlüssel).
# AI_PROVIDER: anthropic | groq | gemini | openai_compatible – leer = erster Anbieter mit Schlüssel
AI_PROVIDER=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Beliebige OpenAI-kompatible API (z. B. OpenAI, OpenRouter, LM Studio)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
# Modelle – leer = Standard des Anbieters:
#   anthropic: claude-opus-5-5 (günstiger: claude-sonnet-5-5, claude-haiku-5-5)
#   groq:      Bild qwen/qwen3.8-27b, Text openai/gpt-oss-120b
#   gemini:    gemini-3.8-flash (günstiger: gemini-3.5-flash-lite)
AI_MODEL_VISION=
AI_MODEL_TEXT=
# Eigene API-URLs in der App erlauben (Desktop-App: immer an). Auf öffentlichen Servern aus lassen.
ALLOW_CUSTOM_AI_BASE_URL=0
# Tageslimits pro Nutzer für den Betreiber-Schlüssel (Kostenkontrolle; gilt nicht für eigene Schlüssel)
AI_DAILY_IMAGE_LIMIT=60
AI_DAILY_TEXT_LIMIT=120
# Zeitlimit pro KI-Anfrage in Millisekunden
AI_TIMEOUT_MS=45000

# --- Realistische Live-Anprobe (optional) ------------------------------------
# Decart Lucy VTON: KI zieht Outfits live und fotorealistisch an (Kamerabild geht an Decart, kostenpflichtig).
# Jede Person kann unter „Mein Stil → Realistische Live-Anprobe“ einen eigenen Schlüssel hinterlegen;
# dieser Schlüssel hier gilt für alle ohne eigenen. Schlüssel: https://platform.decart.ai/
DECART_API_KEY=
# Modell (leer = lucy-vton-latest; alternativ lucy-vton-3.6 fest)
DECART_TRYON_MODEL=
# Sitzungen pro Nutzer und Tag mit dem Betreiber-Schlüssel (gilt nicht für eigene Schlüssel)
TRYON_DAILY_SESSIONS=20

# --- Freistellung (optional) -----------------------------------------------
# "photoroom" oder "removebg" – ohne Angabe nur lokale Freistellung im Browser
BG_REMOVAL_PROVIDER=
PHOTOROOM_API_KEY=
REMOVEBG_API_KEY=

# --- Wetter ----------------------------------------------------------------
# Open-Meteo ist ohne Schlüssel nutzbar (nur nicht-kommerziell!). Für kommerzielle Nutzung:
OPEN_METEO_API_KEY=
